     end-if
     if HV-KEY-WORK (1:L) = low-values
        move "No data found or EOF. " to MOST-SQLMSG
        move '02000' to MOST-SQLSTATE
        call 'TranslateFileStatus'
        end-call
*>        invoke self 'TranslateFileStatus'
*>        end-invoke
        move MOST-interface-block to datablock
        exit program
*>        exit method
     end-if
     move HV-KEY-WORK (1:L) to STOCK-REC (K:L)
                               MOST-rel-data
     move STOCK-REC to  MOST-data-buffer
     move MOST-interface-block to datablock
     call "STOCKMTGetRandom"  using datablock   end-call

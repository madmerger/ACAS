             varying J
                from 1
                  by 1
               until J > 12
     *> Load the singleton HVs... 0
     *> Locate current slot in mr array
               perform
                 varying P
                    from 1
                      by 1
                   until P > 12 OR
                 HV-LEVEL-J-rg02mr (P) = J
                 OR
                 HV-LEVEL-J-rg02mr (P) = low-values
               end-perform
               if P > 12    *> data error or DB corruption
                  go to su900
               end-if
     *> build singleton
*>                   move  SH-DATA (J)  to HV-SH-DATA
                      move  STOCK-TD-ADDS (J)  to HV-STOCK-TD-ADDS
                      move  STOCK-TD-DEDS (J)  to HV-STOCK-TD-DEDS
                      move  STOCK-TD-WIP-ADDS (J)  to HV-STOCK-TD-WIP-ADDS
                      move  STOCK-TD-WIP-DEDS (J)  to HV-STOCK-TD-WIP-DEDS
                   move J to HV-LEVEL-J-rg02  HV-J
     *> check for changes
               if
              *> HV-SH-DATA NOT = HV-SH-DATA-rg02mr (P)
              *>        OR
                  HV-STOCK-TD-ADDS NOT = HV-STOCK-TD-ADDS-rg02mr (P)
                      OR HV-STOCK-TD-DEDS NOT = HV-STOCK-TD-DEDS-rg02mr (P)
                      OR HV-STOCK-TD-WIP-ADDS NOT = HV-STOCK-TD-WIP-ADDS-rg02mr (P)
                      OR HV-STOCK-TD-WIP-DEDS NOT = HV-STOCK-TD-WIP-DEDS-rg02mr (P)
     *> check for insert or update
                  if HV-LEVEL-J-rg02mr (P) = low-values
                     EXEC SQL
                        INSERT into [STOCK-RECrg02]
                        ([STOCK-KEY],
*>                        [SH-DATA],
                        [STOCK-TD-ADDS],
                        [STOCK-TD-DEDS],
                        [STOCK-TD-WIP-ADDS],
                        [STOCK-TD-WIP-DEDS],
                        [LEVEL-J])
                     VALUES
                        (:HV-STOCK-KEY-rg02,
*>                        :HV-SH-DATA,
                        :HV-STOCK-TD-ADDS,
                        :HV-STOCK-TD-DEDS,
                        :HV-STOCK-TD-WIP-ADDS,
                        :HV-STOCK-TD-WIP-DEDS,
                        :HV-LEVEL-J-rg02)
                     END-EXEC
                  else
                     move  HV-LEVEL-J-rg02mr (P) to HV-LEVEL-J-rg02  HV-J
                     EXEC SQL
                         UPDATE [STOCK-RECrg02]
*>                                                  SET [SH-DATA]  = :HV-SH-DATA
                         SET [STOCK-TD-ADDS]  = :HV-STOCK-TD-ADDS
                         ,[STOCK-TD-DEDS]  = :HV-STOCK-TD-DEDS
                         ,[STOCK-TD-WIP-ADDS]  = :HV-STOCK-TD-WIP-ADDS
                         ,[STOCK-TD-WIP-DEDS]  = :HV-STOCK-TD-WIP-DEDS
                         WHERE [STOCK-KEY] = :HV-DynamicParm
                         AND [LEVEL-J] = :HV-J
                         END-EXEC
                     end-if
                  end-if
           end-perform
        else
     *> write all slots as new...
     *> update on the main connection (HV-DBRG is for mr only)
           EXEC SQL
              SET CONNECTION :HV-DB
           END-EXEC
           perform
                varying J
                   from 1
                     by 1
                  until J > 12
*>                 move  SH-DATA (J)  to HV-SH-DATA
                    move  STOCK-TD-ADDS (J)  to HV-STOCK-TD-ADDS
                    move  STOCK-TD-DEDS (J)  to HV-STOCK-TD-DEDS
                    move  STOCK-TD-WIP-ADDS (J)  to HV-STOCK-TD-WIP-ADDS
                    move  STOCK-TD-WIP-DEDS (J)  to HV-STOCK-TD-WIP-DEDS
                 move J to HV-LEVEL-J-rg02  HV-J
                 EXEC SQL
                    INSERT into [STOCK-RECrg02]
                        ([STOCK-KEY],
*>                        [SH-DATA],
                        [STOCK-TD-ADDS],
                        [STOCK-TD-DEDS],
                        [STOCK-TD-WIP-ADDS],
                        [STOCK-TD-WIP-DEDS],
                        [LEVEL-J])
                    VALUES
                       (:HV-STOCK-KEY-rg02,
*>                       :HV-SH-DATA,
                       :HV-STOCK-TD-ADDS,
                       :HV-STOCK-TD-DEDS,
                       :HV-STOCK-TD-WIP-ADDS,
                       :HV-STOCK-TD-WIP-DEDS,
                       :HV-LEVEL-J-rg02)
                    END-EXEC
            end-perform
        end-if
     *> END of UPDATE process for STOCK-RECrg02


     end-if
     .
 SU900.
     EXEC SQL
        commit work
     END-EXEC
     move saved-SQLSTATE to SQLSTATE
     move saved-SQLMSG   to SQLMSG

     .
 su999.
     exit.

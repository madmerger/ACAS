 01  DBaction pic x(8).
 01  work-buffer pic x(512).                  *> change for OC
 LINKAGE SECTION.
 01  datablock pic x(8192).
 PROCEDURE       DIVISION   using datablock.
 MAIN SECTION.
 P001.
     move datablock to MOST-interface-block
     move MOST-data-buffer  to STOCK-REC
     set MOST-getsequential to TRUE
     if MOST-cursor-NOT-active
        if MOST-START-required
          move '99RNP' to MOST-SQLSTATE
          move 'READ NEXT with no position established.' to        MOST-SQLMsg
          move '46' to MOST-file-status
          move MOST-interface-block to datablock
          go to p001-end
        else
*>
*> start a cursor on the passed KOR...
*> Analyse the interface and build the condition required...
*>
             if (MOST-which-key > 1 OR MOST-which-key < 1)             *>  > 3  or < 1
                move 'NO valid Key specified to STOCKMTStart' to   MOST-SQLMsg
                move '99NKS' to MOST-SQLSTATE
                move MOST-interface-block to datablock
                go to p001-end
             end-if
             set KOR-x1 to MOST-which-key
*> Key index is OK so set key field to low values...
             move KOR-offset (KOR-x1) to K
             move KOR-length (KOR-x1) to L
             move '>=' to MOST-relation
             move low-values to MOST-data-buffer (K:L)
             move MOST-interface-block to datablock
             call "STOCKMTStart"  using datablock end-call
*>             invoke SELF "STOCKMTStart"
*>                 using datablock
*>             end-invoke
             move datablock to MOST-interface-block


             if SQLSTATE NOT = '00000'
                move spaces to work-buffer
                string
                   MOST-SQLSTATE    delimited by size
                   " - "            delimited by size
                   MOST-SQLMSG      delimited by "   "
                   space            delimited by size
                   ' - Could not generate START for READ NEXT.'
                                    delimited by size          into  work-buffer
                end-string
                move '99GNS' to SQLSTATE

                move work-buffer to MOST-SQLMsg
                move '46' to MOST-file-status
                move MOST-interface-block to datablock
                go to p001-end
             end-if
        end-if
     end-if
*> use HandleDB to get the data
     move 'getnext ' to DBaction
     call 'HandleDB' using DBaction end-call
*>     invoke SELF 'HandleDB'                               *> changes for OC
*>            using DBaction
*>     end-invoke
     move SQLSTATE to MOST-SQLSTATE
     move SQLMsg   to MOST-SQLMsg
     if MOST-SQLSTATE = '00000' or MOST-SQLSTATE (1:2) = '01'
        move '00000' to MOST-SQLSTATE
        call 'UnLoadHVs' end-call
*>        invoke self 'UnLoadHVs' end-invoke                 *> change for OC
        move zero to MOST-file-status
        move KOR-offset (KOR-x1) to K
        move KOR-length (KOR-x1) to L
        move MOST-data-buffer (K:L) to MOST-rel-data

     else
        call "TranslateFileStatus"
*>        invoke self "TranslateFileStatus"                   *> changes for OC
     end-if
     .
 p001-end.
     move MOST-interface-block to datablock
     .


*> START OF METHOD - HandleDB
*>**
*>                 Called by : Init
*>                             delete
*>                             Update
*>                             write
*>                             close
*>                             start
*>                             getrec
*>                             getrandom
*>                             getnext
*>**
*>
*>  This method handles all the SQL actions that are required by MOST.
*>  Because of Method encapsulation I could find no way to share an SQL
*>  cursor across methods, so finally opted to put everything here.
*>
*>  This method must be passed an action, which it then carries out.
*>
*>  If the action is successful the passed action is blanked, otherwise
*>  SQLSTATE and SQLMsg are set with information about the problem.
*>
 IDENTIFICATION DIVISION.
 program-ID. HandleDB.
*> METHOD-ID. HandleDB AS "HandleDB".                   *> changed for OC
 ENVIRONMENT     DIVISION.
 DATA            DIVISION.
 WORKING-STORAGE SECTION.
 01  saved-SQLSTATE   pic x(5).
 01  saved-SQLMSG     pic x(512).
 LINKAGE SECTION.
 01  DBaction    pic x(8).
 PROCEDURE DIVISION using DBAction.
 MAIN SECTION.
 P001.
     if DBaction NOT = 'init'
        if NOT (DBaction = 'start' or 'getnext')
            EXEC SQL
              SET CONNECTION :HV-DB
            END-EXEC
            move SQLSTATE to MOST-SQLSTATE
            MOVE SQLMSG   to MOST-SQLMSG
            if SQLSTATE NOT = '00000'
               go to p001-end
            end-if
        else
        *> swap connections for SQL Server to avoid 'S1000'...
            EXEC SQL
               SET CONNECTION :HV-DBSEQ
            END-EXEC
            move SQLSTATE to MOST-SQLSTATE
            MOVE SQLMSG   to MOST-SQLMSG
            if SQLSTATE NOT = '00000'
               go to p001-end
            end-if
        end-if
     end-if

     evaluate DBaction
        when 'init    '
           perform SQLInit
        when 'start   '
           perform SQLStart
        when 'getnext '
           perform SQLGetNext
        when 'close   '
           perform SQLClose
        when 'finish  '
           perform SQLFinish
        when 'random  '
           perform SQLRandom
        when 'write   '
           perform SQLWrite
        when 'update  '
           perform SQLUpdate
        when 'delete  '
           perform SQLDelete
        when other
           move '99HDA' to SQLSTATE
           move 'Invalid action passed to HandleDB...' to SQLMsg
     end-evaluate
     if SQLSTATE = '00000'
        move space to DBaction
     end-if
     .
 p001-end.
     exit program.
*>     exit method.                         changed for OC


*>---------------------------------------------------
 SQLInit section.
 si001.
*>
*> Get the DB connections...normal, sequential, and RG.
*>
     set all-ok to TRUE
     move 'DB connections...HV-DB=' to wk-string
*> CONNECT TO DATABASE ON ACASDB SERVER
     move MOST-instance-stamp to HV-DB
     EXEC SQL
*>  DSN, User and password must be set in the ODBC info file which is external to the MOST handler.
       CONNECT TO 'ACASDB' AS :HV-DB
     END-EXEC
*> CHECK CONNECTION RESULT
     if NOT (SQLSTATE = '00000' OR '01000')
        set not-all-ok to TRUE
     end-if
     string wk-string        delimited by '   '
               SQLSTATE      delimited by size
               ', HV-DBRG='  delimited by size     into wk-string
     end-string
*> Multi-row access for repeating groups needs its own connection.
     move spaces to HV-DBRG
     string HV-DB            delimited by space
            "RG"             delimited by size     into HV-DBRG
     end-string
     EXEC SQL
        CONNECT TO 'ACASDB' AS :HV-DBRG
     END-EXEC
     if NOT (SQLSTATE = '00000' OR '01000')
        set not-all-ok to TRUE
     end-if

     string wk-string        delimited by '   '
               SQLSTATE      delimited by size
               ', HV-DBSEQ=' delimited by size     into wk-string
     end-string

*> Skip sequential access needs its own connection.
     move spaces to HV-DBSEQ
     string HV-DB            delimited by space
            "SEQ"            delimited by size     into HV-DBSEQ
     end-string
     EXEC SQL
        CONNECT TO 'ACASDB' AS :HV-DBSEQ
     END-EXEC
     if NOT (SQLSTATE = '00000' OR '01000')
        set not-all-ok to TRUE
     end-if

     string wk-string        delimited by '   '
               SQLSTATE      delimited by size   into wk-string
     end-string
     if not-all-ok
        move 'FAILD'    to MOST-SQLSTATE
     else
        move '00000'    to MOST-SQLSTATE
     end-if
     MOVE wk-string   to MOST-SQLMSG
                         log-message
       call   "LogIt".                                *> 31/3/12 vbc - remd for OC   using
*>     invoke SELF "LogIt"
     .
 si999.
     exit.
*>---------------------------------------------------
 SQLStart section.
 ss001.
*> Build the dynamic cursor declaration
*>
     EXEC SQL
       DECLARE CUR3 CURSOR FOR CUR3Handle
     END-EXEC

     EXEC SQL
        PREPARE CUR3Handle FROM :CUR3STMVAR
     END-EXEC
*> Open it...
*>
     EXEC SQL
        OPEN CUR3 using :HV-DynamicParm
     END-EXEC
     if SQLSTATE = '00000'
        set MOST-cursor-running to TRUE
     end-if
     .
 ss999.
     exit.

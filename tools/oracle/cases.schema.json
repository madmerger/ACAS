{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACAS shared oracle cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "program", "menu_path", "input", "steps", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "description": {"type": "string", "minLength": 1},
        "program": {"const": "sl070"},
        "menu_path": {"type": "array", "items": {"type": "string"}},
        "input": {"type": "object"},
        "steps": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["expect", "send"],
          "properties": {
            "expect": {"type": "string", "minLength": 1},
            "send": {"type": "string"},
            "capture": {"type": "string", "minLength": 1}
          }
        }},
        "outputs": {"type": "object", "additionalProperties": false,
          "required": ["data", "reports"],
          "properties": {
            "data": {"const": ["analysis", "suppliers"]},
            "reports": {"type": "array", "uniqueItems": true, "items": {"const": "prt-1"}}
          }
        }
      }
    }}
  }
}
